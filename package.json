{
  "name": "compressible",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/upper-cwd.mjs node_modules/vite/bin/vite.js",
    "build": "tsc -b && node scripts/upper-cwd.mjs node_modules/vite/bin/vite.js build",
    "lint": "oxlint",
    "preview": "node scripts/upper-cwd.mjs node_modules/vite/bin/vite.js preview",
    "test": "node scripts/upper-cwd.mjs node_modules/vitest/vitest.mjs run --coverage",
    "test:watch": "node scripts/upper-cwd.mjs node_modules/vitest/vitest.mjs",
    "typecheck": "tsc -b --noEmit",
    "fixtures:vt": "tsx scripts/record-vt-fixtures.ts",
    "verify:ui": "npm run build && tsx scripts/verify-ui.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
